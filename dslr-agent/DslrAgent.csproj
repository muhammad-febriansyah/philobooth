<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DslrAgent</RootNamespace>
    <AssemblyName>philobooth-booth</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Default target: the real Windows kiosk build (net8.0-windows) on
         Windows; the cross-platform mock build (net8.0) elsewhere. Override on
         any OS to cross-build the kiosk exe:
           dotnet publish -c Release -p:TargetFramework=net8.0-windows -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(OS)' == 'Windows_NT'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>

    <!-- Allow building the net8.0-windows target from macOS/Linux (dev + CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Windows kiosk target: real DSLR engine, printing (System.Drawing), and the
       system-tray icon. Keyed on the TFM (not the build OS) so it can be
       cross-built anywhere. Produces a single self-contained
       philobooth-booth.exe. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <!-- CameraControl.Devices 2.0.73 ships Canon EDSDK as native x86 DLLs.
         The process must therefore be x86 or Canon cameras are invisible even
         though Windows lists them in Device Manager. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Deflate the bundled assemblies. Roughly halves the download size, at the
         cost of a slightly slower first start (the bundle is extracted once). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <!-- digiCamControl's camera engine (Nikon well supported, Canon partial),
       Windows-only, drives cameras over PTP/USB. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="CameraControl.Devices" Version="2.0.73-beta" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- CameraControl's Canon backend loads these native SDK files at runtime.
       PackageReference ignores the package's legacy content/ folder and a
       single-file publish also drops ordinary None items. Force-copy them only
       after publish has produced its final directory. -->
  <Target Name="CopyCameraControlNativeRuntime"
          AfterTargets="Publish"
          Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ItemGroup>
      <CameraControlNativeRuntime Include="$(NuGetPackageRoot)cameracontrol.devices/2.0.73-beta/content/EDSDK.dll" />
      <CameraControlNativeRuntime Include="$(NuGetPackageRoot)cameracontrol.devices/2.0.73-beta/content/EdsImage.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CameraControlNativeRuntime)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Optional Canon EDSDK backend (best Canon support). Off by default so the
       standard build needs no proprietary SDK. To enable: drop Canon's
       EDSDKLib.cs wrapper and the native EDSDK DLLs into edsdk/, then build with
         dotnet publish -c Release -p:TargetFramework=net8.0-windows -p:IncludeEdsdk=true
       See edsdk/README.md. -->
  <PropertyGroup Condition="'$(IncludeEdsdk)' == 'true'">
    <DefineConstants>$(DefineConstants);EDSDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeEdsdk)' == 'true'">
    <Compile Include="edsdk/EDSDKLib.cs" />
    <None Include="edsdk/*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

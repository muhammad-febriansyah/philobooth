<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DslrAgent</RootNamespace>
    <AssemblyName>philobooth-dslr-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Cross-platform dev target (macOS/Linux): plain net8.0 with the mock
       camera and mock printer only. The real camera/printer engines and the
       tray icon are Windows-only, so they are excluded from this build. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Windows kiosk target: net8.0-windows enables the real DSLR engine,
       printing (System.Drawing), and the system-tray icon. Build the kiosk
       binary with:
         dotnet publish -c Release
       which produces a single self-contained philobooth-dslr-agent.exe. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <!-- digiCamControl's camera engine (Nikon well supported, Canon partial),
       Windows-only, drives cameras over PTP/USB. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="CameraControl.Devices" Version="2.0.6" />
  </ItemGroup>

  <!-- Optional Canon EDSDK backend (best Canon support). Off by default so the
       standard build needs no proprietary SDK. To enable: drop Canon's
       EDSDKLib.cs wrapper and the native EDSDK DLLs into edsdk/, then build with
         dotnet publish -c Release -p:IncludeEdsdk=true
       See edsdk/README.md. -->
  <PropertyGroup Condition="'$(IncludeEdsdk)' == 'true'">
    <DefineConstants>$(DefineConstants);EDSDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeEdsdk)' == 'true'">
    <Compile Include="edsdk/EDSDKLib.cs" />
    <None Include="edsdk/*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

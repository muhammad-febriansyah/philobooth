<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DslrAgent</RootNamespace>
    <AssemblyName>philobooth-dslr-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Default target: the real Windows kiosk build (net8.0-windows) on
         Windows; the cross-platform mock build (net8.0) elsewhere. Override on
         any OS to cross-build the kiosk exe:
           dotnet publish -c Release -p:TargetFramework=net8.0-windows -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(OS)' == 'Windows_NT'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>

    <!-- Allow building the net8.0-windows target from macOS/Linux (dev + CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Windows kiosk target: real DSLR engine, printing (System.Drawing), and the
       system-tray icon. Keyed on the TFM (not the build OS) so it can be
       cross-built anywhere. Produces a single self-contained
       philobooth-dslr-agent.exe. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <!-- digiCamControl's camera engine (Nikon well supported, Canon partial),
       Windows-only, drives cameras over PTP/USB. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="CameraControl.Devices" Version="2.0.73-beta" />
  </ItemGroup>

  <!-- Optional Canon EDSDK backend (best Canon support). Off by default so the
       standard build needs no proprietary SDK. To enable: drop Canon's
       EDSDKLib.cs wrapper and the native EDSDK DLLs into edsdk/, then build with
         dotnet publish -c Release -p:TargetFramework=net8.0-windows -p:IncludeEdsdk=true
       See edsdk/README.md. -->
  <PropertyGroup Condition="'$(IncludeEdsdk)' == 'true'">
    <DefineConstants>$(DefineConstants);EDSDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeEdsdk)' == 'true'">
    <Compile Include="edsdk/EDSDKLib.cs" />
    <None Include="edsdk/*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
